__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
.atl/

# `pip install -e .` (pyproject.toml, Task A) writes these into the repo root.
*.egg-info/
/build/

# Per-unit drift fingerprints. Derived, machine-specific, and deliberately NOT
# committed: bench/drift-baseline.json is public and privacy-reviewed down to
# rule ids, while this file identifies each installed bundle by content hash.
# Regenerated by `make drift-freeze`; absent, `make drift` falls back to the
# aggregate-only comparison.
bench/.drift-units.json

# bench.public's fetch cache no longer defaults to anywhere inside this tree
# — it is a gigabyte of third-party checkouts, and `make selftest` and
# `make schema` scan `.` (see bench/public.py::DEFAULT_CACHE). This entry
# stays only to catch a `--cache` explicitly pointed back in here.
bench/.public-cache/
